{
  // Type-checks the frontend (`npm run typecheck`, run in CI). Nothing is
  // emitted: Vite and Vitest compile .ts/.tsx themselves.
  //
  // src/ is all TypeScript (issue #587), so JavaScript is not part of the
  // program; `npm run typescript:check` keeps .js/.jsx files out of src/.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    // `node`: a few tests read source files (e.g. index.css) through node:fs.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest", "node"]
  },
  "include": ["src"],
  "exclude": ["src/**/node_modules"]
}
