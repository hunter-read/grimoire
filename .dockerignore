# Patterns are matched against the whole path, so a bare `__pycache__` only
# excludes a root-level one. Anything that can appear at any depth needs `**/`.
.git
.gitignore
library/
data/
# Runtime data and credentials, wherever they sit in a working tree, so an
# image built from a dev checkout never carries a database, key or seed file.
**/data/
**/*.db
**/*.db-*
**/secret_key
**/.env
**/users.json
**/users.json.*
**/*.md
# …except the changelog, which the About dialog reads at runtime.
!CHANGELOG.md
LICENSE
.env
**/__pycache__
**/*.pyc
.vscode
.idea
frontend/node_modules
frontend/dist
frontend/coverage
backend/tests
**/.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.json
pytest.ini
requirements-test.txt
